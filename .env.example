# ============================================================
# Hexo blogging platform — environment variables
# All variables are OPTIONAL; the template works with zero config.
# ============================================================

# --- Web server ---
# Port nginx listens on (fixed at 80; Railway routes the public domain here)
PORT=80
# Container timezone (IANA name)
TZ=UTC

# --- hexo-admin (web editor at /admin/) ---
# Set ADMIN_PASSWORD to protect the editor with a login.
# Leave empty for open access (anyone can create/edit posts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Artalk comments (at /comment/) ---
# Site name shown in the comment widget
ARTALK_SITE_DEFAULT=My Hexo Blog
# Public URL (auto-derived from RAILWAY_PUBLIC_DOMAIN if unset)
ARTALK_SITE_URL=
# Storage: sqlite (default, lives on the volume) | pgsql | mysql | mssql
ARTALK_DB_TYPE=sqlite
# When ARTALK_DB_TYPE is not sqlite, provide a connection string:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# First-run admin account (optional). If unset, register the first admin
# from the dashboard login page at /comment/admin/
ARTALK_ADMIN_NAME=admin
ARTALK_ADMIN_EMAIL=
ARTALK_ADMIN_PASSWORD=
# Extra origins allowed to call the comment API (space-separated)
ARTALK_TRUSTED_DOMAINS=
# UI language / timezone (e.g. en, zh-CN, ja, fr, ko, ru, tr)
ARTALK_LOCALE=en
ARTALK_TIMEZONE=UTC

# --- MinIO (S3-compatible object storage at /minio/) ---
# Root credentials. MINIO_ROOT_PASSWORD is generated as a random secret
# by the deploy form; rotate it in the dashboard afterwards.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# S3 endpoint for clients (mc, rclone, SDKs):  https://<your-domain>/minio
# Path-style access: https://<your-domain>/minio/<bucket>/<key>
# Web console:       https://<your-domain>/minio-console/

# --- Web terminal (at /terminal/) ---
# ttyd runs an open shell in /app for hexo CLI, git, mc, npm tasks.
# There is no auth on the terminal — keep the URL private, or add
# an IP allowlist in nginx.conf if you deploy publicly.

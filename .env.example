# ============================================================
# Hexo blogging platform — environment variables
# Three services: hexo (blog + admin + terminal), comments (Artalk), storage (MinIO)
# All variables are OPTIONAL; the template works with zero config.
# ============================================================

# --- Global ---
# Container timezone (IANA name)
TZ=UTC

# --- hexo service (blog at /, admin at /admin/, terminal at /terminal/) ---
# Port nginx listens on (fixed at 80; Railway routes the public domain here)
PORT=80
# hexo-admin (web editor at /admin/) credentials
# Set ADMIN_PASSWORD to protect the editor and the /terminal/ web shell.
# Leave empty for open access (anyone can create/edit posts and open a shell).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# S3-backed image upload (hexo service stores editor-uploaded images in MinIO)
# Auto-derived from the storage service on Railway; unset to keep local saves.
# MINIO_ENDPOINT=https://<storage-domain>
# MINIO_ACCESS_KEY=<storage MINIO_ROOT_USER>
# MINIO_SECRET_KEY=<storage MINIO_ROOT_PASSWORD>
# MINIO_BUCKET=blog-images

# --- comments service (Artalk on its own service URL) ---
# Site name shown in the comment widget
ARTALK_SITE_NAME=My Hexo Blog
# Public URL (auto-derived from comments service's RAILWAY_PUBLIC_DOMAIN if unset)
ARTALK_SITE_URL=
# Storage: sqlite (default, lives on the volume) | pgsql | mysql | mssql
ARTALK_DB_TYPE=sqlite
# When ARTALK_DB_TYPE is not sqlite, provide a connection string:
# DATABASE_URL=postgres://user:***@host:5432/dbname
# First-run admin account (optional). If unset, register the first admin
# from the dashboard login page at /sidebar/ on the comments service URL
ARTALK_ADMIN_NAME=admin
ARTALK_ADMIN_EMAIL=
ARTALK_ADMIN_PASSWORD=
# JWT signing key for Artalk (must be stable across restarts).
# Auto-generated by the deploy form; rotate it in the dashboard afterwards.
ARTALK_APP_KEY=
# Extra origins allowed to call the comment API (space-separated)
# Auto-includes hexo's public domain via template var
ARTALK_TRUSTED_DOMAINS=
# UI language / timezone (e.g. en, zh-CN, ja, fr, ko, ru, tr)
ARTALK_LOCALE=en
ARTALK_TIMEZONE=UTC

# --- storage service (MinIO on its own service URL) ---
# Root credentials. MINIO_ROOT_PASSWORD is generated as a random secret
# by the deploy form; rotate it in the dashboard afterwards.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# S3 endpoint for clients (mc, rclone, SDKs):  https://<storage-domain>
# Path-style access: https://<storage-domain>/<bucket>/<key>
# (The web console binds an internal port and is not publicly exposed.)
